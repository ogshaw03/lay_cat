# このファイルは wrangler.toml のテンプレート。
# 実際に使うときは、同じディレクトリに `wrangler.toml` という名前でコピーして値を埋める。
# （wrangler.toml 本体は commit 済みだが、別環境向けカスタマイズのため example も残す）

name = "laycat-r2-api"
main = "laycat-r2-api.js"
compatibility_date = "2025-01-01"

# R2 バケットのバインディング。ダッシュボードで作った bucket 名を書く。
[[r2_buckets]]
binding = "R2"
bucket_name = "laycat-projects"

[vars]
# Firebase Auth と Firestore のプロジェクトID
# ※ LayCAT 本体の firebaseConfig.projectId と一致させる必要がある（Firebase トークンの
#   aud フィールド検証に使うため）。間違うと "aud mismatch" で全リクエストが 401 になる。
FIREBASE_PROJECT_ID = "laycat-54ee4"

# CORS 許可オリジン（カンマ区切り。* も可だが本番は避ける）
# ※ 先頭のオリジンは Worker が access.json を取りに行く先にも使われる。GitHub Pages を先頭に。
ALLOW_ORIGIN = "https://ogshaw03.github.io,http://127.0.0.1:8765,http://localhost:8765"

# ファイルサイズ上限（省略時のデフォルト: JSON=10MB, MEDIA=500MB, ANY=2GB）
# バイト単位。用途に応じて上げ下げ可能。
# MAX_JSON_BYTES = "10485760"        # 10 MB
# MAX_MEDIA_BYTES = "524288000"      # 500 MB
# MAX_ANY_BYTES = "2147483648"       # 2 GB（絶対上限・安全網）

# 以下は wrangler secret put で登録:
#   wrangler secret put FIREBASE_SERVICE_ACCOUNT
#   （Firebase コンソールの Service accounts > Generate new private key で得た JSON を
#    そのまま貼り付ける。改行はそのままで OK）
#   既存の Worker を上書きデプロイする場合は、登録済み secret がそのまま維持されるので再登録不要。
